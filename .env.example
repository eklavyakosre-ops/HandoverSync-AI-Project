# Required for server-side Gemini AI handover extraction, Knowledge Gap Detector, and Q&A
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Public application URL used to build OAuth redirect/callback URIs
# Local dev: http://localhost:3000
# Deployed: your https://... app URL
APP_URL="http://localhost:3000"

# Server-side OAuth App Credentials (required to enable OAuth authorization for each provider)
# GitHub OAuth Callback: ${APP_URL}/api/integrations/github/callback
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Slack OAuth Callback: ${APP_URL}/api/integrations/slack/callback
SLACK_CLIENT_ID=""
SLACK_CLIENT_SECRET=""

# Jira Cloud (Atlassian) OAuth Callback: ${APP_URL}/api/integrations/jira/callback
JIRA_CLIENT_ID=""
JIRA_CLIENT_SECRET=""

